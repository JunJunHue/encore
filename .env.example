# Copy to .env.local and fill in from your Supabase project dashboard.
# .env.local is gitignored — never commit real credentials.

# Project URL: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon (public) key: Supabase Dashboard → Project Settings → API → anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Direct Postgres connection string — SERVER-SIDE SCRIPTS ONLY (db:seed, demo:reset).
# Never exposed to the client (no VITE_ prefix).
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Demo login (seeded by seed.sql; see README): open the app with ?as=demo to sign in as
# demo@encore.app / encore-demo-2026 (constants DEMO_EMAIL / DEMO_PASSWORD in src/lib/auth.ts).
# Dashboard prerequisite: Authentication → Providers → enable Anonymous sign-ins; disable captcha.
